# =========================
# MongoDB (required)
# =========================
# Local:
#   mongodb://localhost:27017
# Atlas:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database name used in code: APPRIC (lib/mongodb.ts)
# Website collections: contact_messages, blog_posts, projects, services
# Portal collections: portal_users, portal_attendance, portal_work_logs, portal_leave_requests

# =========================
# Attendance portal (required)
# =========================
# Long random string used to sign login cookies
AUTH_SECRET=replace-with-a-long-random-string

# First admin is created automatically if no user with this email exists
ADMIN_EMAIL=admin@appric.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=APPRIC Admin
