# Copy to .env.local in this folder:
#   copy env.local.example .env.local
#
# App code is unchanged. These values are injected by Docker.

MONGODB_URI=mongodb://mongodb:27017
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@appric.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=APPRIC Admin

# Cloudinary CMS images (appric/portfolio, appric/blog, appric/team, appric/logos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=appric
