# Copy to .env.host in this folder:
#   copy env.host.example .env.host
#
# Default: Atlas (or any remote Mongo URI). App code is unchanged.
# If you also start host Mongo with --profile mongo, use:
#   MONGODB_URI=mongodb://mongodb:27017

MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@appric.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=APPRIC Admin
NODE_ENV=production

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=appric
